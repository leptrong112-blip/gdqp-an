# GEMINI_API_KEY: Khóa API Google Gemini từ Google AI Studio (bắt buộc cho Trợ giảng AI)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: Địa chỉ chạy website (mặc định môi trường dev: http://localhost:3001)
APP_URL="http://localhost:3001"

# ADMIN_INITIAL_PASSWORD: Mật khẩu khởi tạo cho tài khoản Quản trị viên admin (tùy chọn)
ADMIN_INITIAL_PASSWORD="ChangeThisPassword123!"
