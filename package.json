{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "cloudflare:dev": "npm run build:client && wrangler dev",
    "cloudflare:deploy": "npm run build:client && wrangler deploy",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc -p cloudflare/tsconfig.json --noEmit",
    "test:pose": "node --import tsx --test scripts/tests/pose-*.test.ts",
    "assets:build": "node scripts/build-training-assets.mjs",
    "assets:inspect": "node scripts/inspect-soldier.mjs",
    "assets:polish": "node scripts/polish-training-materials.mjs",
    "assets:verify-materials": "node scripts/verify-training-materials.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mediapipe/tasks-vision": "0.10.17",
    "@netlify/blobs": "^11.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@gltf-transform/cli": "4.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "netlify-cli": "^27.5.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "4.40.0"
  }
}
